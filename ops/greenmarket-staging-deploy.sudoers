# This account is restricted by sshd to the fixed receiver script. The root
# helpers validate every action before switching a release or applying a
# migration. No interactive shell and no other sudo commands are granted.
greenmarket-deploy ALL=(root) NOPASSWD: /usr/local/libexec/greenmarket-staging-activate
greenmarket-deploy ALL=(root) NOPASSWD: /usr/local/libexec/greenmarket-staging-migrate
