# Development may run UI without a database.
# Catalogue stage 2 local Postgres: docker compose -f docker-compose.dev.yml up -d
# Then: set DATABASE_URL and npm run db:up
DATABASE_URL=postgresql://greenmarket:local-dev-only-change-me@127.0.0.1:55434/greenmarket
APP_BASE_URL=https://example.invalid

