{
  "name": "greenmarket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "predev": "tsx scripts/check-runtime.ts && tsx scripts/build-sprite.ts",
    "prebuild": "tsx scripts/check-runtime.ts && tsx scripts/build-sprite.ts",
    "prestart": "tsx scripts/check-runtime.ts && tsx scripts/build-sprite.ts",
    "prelint": "tsx scripts/check-runtime.ts",
    "pretypecheck": "tsx scripts/check-runtime.ts",
    "pretest": "tsx scripts/check-runtime.ts",
    "pretest:watch": "tsx scripts/check-runtime.ts",
    "preverify:local-health": "tsx scripts/check-runtime.ts",
    "preverify:production-startup": "tsx scripts/check-runtime.ts",
    "predb:create": "tsx scripts/check-runtime.ts",
    "predb:up": "tsx scripts/check-runtime.ts",
    "predb:down": "tsx scripts/check-runtime.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "tsx scripts/start-production.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:local-health": "tsx scripts/verify-local-health.ts",
    "verify:production-startup": "tsx scripts/verify-production-startup.ts",
    "db:create": "node-pg-migrate create --migrations-dir db/migrations",
    "db:up": "node-pg-migrate up --migrations-dir db/migrations",
    "db:down": "node-pg-migrate down --migrations-dir db/migrations",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:production-startup && npm run verify:local-health"
  },
  "dependencies": {
    "@fontsource/manrope": "5.2.8",
    "@fontsource/montserrat": "5.3.0",
    "next": "16.3.0",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "node-pg-migrate": "9.0.0",
    "sass": "1.99.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
